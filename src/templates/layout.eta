<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= it.title %> | ATP-OSM Sync</title>
    <link href="<%= it.basePath %>/style.css" rel="stylesheet">
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen p-4 md:p-8 md:pt-0">
    <div class="max-w-7xl mx-auto">
        <%~ it.body %>
    </div>

    <!-- Modal backdrop -->
    <div id="modal-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden"></div>

    <!-- JOSM Error Modal -->
    <div id="josm-modal" class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-gray-900 border border-gray-700 rounded-xl shadow-2xl z-50 hidden">
        <div class="p-6">
            <div class="flex items-center gap-4 mb-4 text-red-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <h3 class="text-xl font-bold">JOSM Not Found</h3>
            </div>
            <p class="text-gray-300 mb-6">
                It looks like JOSM is not running or the Remote Control feature is disabled.
                Please ensure JOSM is open and Remote Control is enabled in preferences.
            </p>
            <div class="flex justify-end">
                <button onclick="document.getElementById('josm-modal').classList.add('hidden'); document.getElementById('modal-backdrop').classList.add('hidden');"
                        class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white rounded-lg transition-colors border border-gray-600">
                    Close
                </button>
            </div>
        </div>
    </div>

    <footer class="max-w-7xl mx-auto mt-12 pt-8 border-t border-gray-800 text-gray-500 text-sm">
        <div class="flex flex-wrap gap-x-8 gap-y-2">
            <div><strong>ATP Data:</strong> <%= it.atpDate %></div>
            <div><strong>OSM Data:</strong> <%= it.osmDate %></div>
        </div>
    </footer>
</body>
</html>
