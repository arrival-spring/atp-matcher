<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= it.title %> | ATP-OSM Sync</title>
    <link href="./style.css" rel="stylesheet">
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen p-8">
    <div class="max-w-7xl mx-auto">
        <%~ it.body %>
    </div>

    <footer class="max-w-7xl mx-auto mt-12 pt-8 border-t border-gray-800 text-gray-500 text-sm">
        <div class="flex flex-wrap gap-x-8 gap-y-2">
            <div><strong>ATP Data:</strong> <%= it.atpDate %></div>
            <div><strong>OSM Data:</strong> <%= it.osmDate %></div>
        </div>
    </footer>
</body>
</html>
