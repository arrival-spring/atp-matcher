<% layout("./layout") %>

<nav class="mb-8">
    <a href="index.html" class="text-blue-400 hover:underline">← Back to Index</a>
</nav>

<header class="mb-12">
    <h1 class="text-4xl font-extrabold mb-2"><%= it.name %></h1>

    <% if (it.isStale) { %>
        <div class="bg-orange-900/20 border border-orange-500/50 text-orange-200 p-4 rounded-lg mb-6">
            <p class="font-bold">⚠️ Stale Data</p>
            <p class="text-sm">The latest ATP run was empty. Showing data from <%= it.staleDate.substring(0, 10) %> instead.</p>
        </div>
    <% } %>

    <% if (it.loadStatus === 'missing' || it.loadStatus === 'empty') { %>
        <div class="bg-red-900/20 border border-red-500/50 text-red-200 p-4 rounded-lg mb-6">
            <p class="font-bold">❌ No Data Available</p>
            <p class="text-sm">
                <% if (it.loadStatus === 'missing') { %>
                    The latest ATP run for this spider could not be found (404).
                <% } else { %>
                    All recent ATP runs for this spider were empty.
                <% } %>
            </p>
        </div>
    <% } %>

    <% if (!it.isBrandSpider) { %>
        <div class="bg-red-900/20 border border-red-500/50 text-red-200 p-4 rounded-lg mb-6">
            <p class="font-bold">❌ Not a Brand Spider</p>
            <p class="text-sm">This spider does not have the expected <code>spider:lineage=S_ATP_BRANDS</code> attribute.</p>
        </div>
    <% } %>

    <div class="text-gray-400 text-sm flex gap-4">
        <a href="https://data.alltheplaces.xyz/runs/latest/output/<%= it.name %>.geojson" target="_blank" class="text-blue-400 hover:underline inline-flex items-center">
            GeoJSON
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        <a href="https://github.com/alltheplaces/alltheplaces/tree/master/locations/spiders/<%= it.name %>.py" target="_blank" class="text-blue-400 hover:underline inline-flex items-center">
            Spider Source
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
    </div>
</header>

<!-- Tag Tabs -->
<div class="mb-8 border-b border-gray-700">
    <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="tag-tabs" role="tablist">
        <li class="mr-2" role="presentation">
            <button class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-300 hover:border-gray-300 transition-colors cursor-pointer" id="summary-tab" data-tab="summary" type="button" role="tab">Summary</button>
        </li>
        <li class="mr-2" role="presentation">
            <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-300 hover:border-gray-300 transition-colors cursor-pointer" id="unmapped-tab" data-tab="unmapped" type="button" role="tab">Not Mapped</button>
        </li>
        <% if (it.results.some(r => r.matchCount > 1)) { %>
            <li class="mr-2" role="presentation">
                <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-300 hover:border-gray-300 transition-colors cursor-pointer" id="duplicate-refs-tab" data-tab="duplicate-refs" type="button" role="tab">Duplicate Refs</button>
            </li>
        <% } %>
        <% it.importableTags.forEach(function(tag) { %>
            <li class="mr-2" role="presentation">
            <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-300 hover:border-gray-300 transition-colors cursor-pointer" id="<%= tag %>-tab" data-tab="<%= tag %>" type="button" role="tab"><%= tag %></button>
            </li>
        <% }) %>
    </ul>
</div>

<!-- Tab Content -->
<div id="tab-content">
    <% const isUniquelyMatched = r => r.matchCount === 1 && !['disallowed source uri', 'not a brand spider'].includes(r.status); %>
    <!-- Summary Section -->
    <div class="hidden space-y-8" id="summary-content" role="tabpanel">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-gray-800 p-6 rounded-lg border border-gray-700 cursor-pointer hover:bg-gray-700 transition-colors" onclick="document.getElementById('unmapped-tab').click()">
                <h3 class="text-xl font-bold mb-4 text-gray-100">Not Mapped</h3>
                <div class="text-3xl font-mono text-gray-200">
                    <%= it.results.filter(r => r.status === 'disallowed source uri' || (!isUniquelyMatched(r) && r.matchCount <= 1)).length %>
                </div>
            </div>
            <% if (it.results.some(r => r.matchCount > 1)) { %>
                <div class="bg-gray-800 p-6 rounded-lg border border-gray-700 cursor-pointer hover:bg-gray-700 transition-colors" onclick="document.getElementById('duplicate-refs-tab').click()">
                    <h3 class="text-xl font-bold mb-4 text-gray-100">Duplicate Refs</h3>
                    <div class="text-3xl font-mono text-gray-200">
                        <%= it.results.filter(r => r.matchCount > 1).length %>
                    </div>
                </div>
            <% } %>
            <% it.importableTags.forEach(function(tag) { %>
                <div class="bg-gray-800 p-6 rounded-lg border border-gray-700 cursor-pointer hover:bg-gray-700 transition-colors" onclick="document.getElementById('<%= tag %>-tab').click()">
                    <h3 class="text-xl font-bold mb-4 text-gray-100"><%= tag %></h3>
                    <div class="space-y-2">
                        <%
                           const stats = {};
                           it.results.filter(isUniquelyMatched).forEach(r => {
                               const t = r.tags.find(tt => tt.tag === tag);
                               if (t) {
                                   stats[t.status] = (stats[t.status] || 0) + 1;
                               }
                           });
                           const sortedStatuses = Object.keys(stats).sort((a, b) => {
                               const priorities = ['disallowed source uri', 'mismatch', 'update OSM', 'Add to OSM', 'matching'];
                               return priorities.indexOf(a) - priorities.indexOf(b);
                           });
                        %>
                        <% sortedStatuses.forEach(function(status) { %>
                            <% if (status === 'not mapped') return; %>
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-gray-400 capitalize"><%= status %></span>
                                <span class="font-mono text-gray-200"><%= stats[status] %></span>
                            </div>
                        <% }) %>
                        <% if (Object.keys(stats).length === 0) { %>
                            <p class="text-gray-500 italic">No data available</p>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Unmapped Section -->
    <div class="hidden" id="unmapped-content" role="tabpanel">
        <% if (!it.isBrandSpider) { %>
            <div class="bg-red-900/20 border border-red-500/50 text-red-200 p-4 rounded-lg mb-6">
                <p class="font-bold">Not a brand spider</p>
                <p class="text-sm">Lineage: <%= it.lineage || 'not found' %></p>
            </div>
        <% } %>
        <div class="overflow-x-auto bg-gray-900 rounded-lg shadow mb-6 max-h-[80vh]">
            <table class="min-w-full table-auto" id="unmapped-table">
                <thead class="bg-gray-800 text-gray-400 text-left sticky top-0 z-10 shadow-sm">
                    <tr>
                        <th class="px-4 py-3">Ref</th>
                        <th class="px-4 py-3">Tags</th>
                        <th class="px-4 py-3">Status</th>
                    </tr>
                </thead>
                <tbody class="text-gray-300 divide-y divide-gray-800">
                    <!-- Rows injected by JS -->
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="flex justify-between items-center bg-gray-800 p-4 rounded-lg" id="unmapped-pagination">
            <button class="prev-btn bg-gray-700 px-4 py-2 rounded hover:bg-gray-600 disabled:opacity-50 transition-colors cursor-pointer">Previous</button>
            <span class="page-info text-gray-400 font-medium">Page 1 of 1</span>
            <button class="next-btn bg-gray-700 px-4 py-2 rounded hover:bg-gray-600 disabled:opacity-50 transition-colors cursor-pointer">Next</button>
        </div>
    </div>

    <!-- Duplicate Refs Section -->
    <div class="hidden" id="duplicate-refs-content" role="tabpanel">
        <div class="overflow-x-auto bg-gray-900 rounded-lg shadow mb-6 max-h-[80vh]">
            <table class="min-w-full table-auto" id="duplicate-refs-table">
                <thead class="bg-gray-800 text-gray-400 text-left sticky top-0 z-10 shadow-sm">
                    <tr>
                        <th class="px-4 py-3">Ref</th>
                        <th class="px-4 py-3">Tags</th>
                        <th class="px-4 py-3">Status</th>
                    </tr>
                </thead>
                <tbody class="text-gray-300 divide-y divide-gray-800">
                    <!-- Rows injected by JS -->
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="flex justify-between items-center bg-gray-800 p-4 rounded-lg" id="duplicate-refs-pagination">
            <button class="prev-btn bg-gray-700 px-4 py-2 rounded hover:bg-gray-600 disabled:opacity-50 transition-colors cursor-pointer">Previous</button>
            <span class="page-info text-gray-400 font-medium">Page 1 of 1</span>
            <button class="next-btn bg-gray-700 px-4 py-2 rounded hover:bg-gray-600 disabled:opacity-50 transition-colors cursor-pointer">Next</button>
        </div>
    </div>

    <!-- Tag Specific Section Template -->
    <% it.importableTags.forEach(function(tag) { %>
        <div class="hidden" id="<%= tag %>-content" role="tabpanel">
            <!-- Status Filters -->
            <div class="flex flex-wrap gap-2 mb-6" id="<%= tag %>-status-filters">
                <%
                   const tagStatuses = new Set();
                   it.results.filter(isUniquelyMatched).forEach(r => {
                       const t = r.tags.find(tt => tt.tag === tag);
                       if (t) tagStatuses.add(t.status);
                   });
                   const allPossibleStatuses = ['disallowed source uri', 'mismatch', 'update OSM', 'Add to OSM', 'matching'];
                %>
                <% allPossibleStatuses.forEach(function(status) { %>
                    <% const count = it.results.filter(r => isUniquelyMatched(r) && r.tags.find(tt => tt.tag === tag && tt.status === status)).length; %>
                    <% if (count === 0 && status === 'disallowed source uri') { return; } %>
                    <button
                        class="px-4 py-2 rounded-full text-sm font-medium border transition-colors <%= count > 0 ? 'border-gray-600 text-gray-300 hover:bg-gray-700 cursor-pointer' : 'border-gray-800 text-gray-600 cursor-not-allowed' %>"
                        data-status="<%= status %>"
                        <%= count === 0 ? 'disabled' : '' %>
                    >
                        <span class="capitalize"><%= status %></span>
                        <span class="ml-2 px-2 py-0.5 rounded-full bg-gray-900 text-xs"><%= count %></span>
                    </button>
                <% }) %>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto bg-gray-900 rounded-lg shadow mb-6 max-h-[80vh]">
                <table class="min-w-full table-auto" id="<%= tag %>-table">
                    <thead class="bg-gray-800 text-gray-400 text-left sticky top-0 z-10 shadow-sm">
                        <!-- Headers injected by JS -->
                    </thead>
                    <tbody class="text-gray-300 divide-y divide-gray-800">
                        <!-- Rows injected by JS -->
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="flex justify-between items-center bg-gray-800 p-4 rounded-lg" id="<%= tag %>-pagination">
                <button class="prev-btn bg-gray-700 px-4 py-2 rounded hover:bg-gray-600 disabled:opacity-50 transition-colors cursor-pointer">Previous</button>
                <span class="page-info text-gray-400 font-medium">Page 1 of 1</span>
                <button class="next-btn bg-gray-700 px-4 py-2 rounded hover:bg-gray-600 disabled:opacity-50 transition-colors cursor-pointer">Next</button>
            </div>
        </div>
    <% }) %>
</div>

<script type="module">
    import { initSpiderDashboard } from './spider.js';
    initSpiderDashboard(<%~ JSON.stringify(it.results) %>, <%~ JSON.stringify(it.importableTags) %>, <%~ JSON.stringify(it.atpDate) %>);
</script>
