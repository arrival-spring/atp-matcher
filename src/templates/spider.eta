<% layout("./layout") %>

<nav class="mb-8">
    <a href="index.html" class="text-blue-400 hover:underline">← Back to Index</a>
</nav>
<header class="mb-12">
    <h1 class="text-4xl font-extrabold mb-2"><%= it.name %></h1>
    <p class="text-gray-400">Last updated: <%= it.lastSync %></p>
</header>

<% Object.keys(it.grouped).sort().forEach(function(status) { %>
    <% const rows = it.grouped[status]; %>
    <div class="mb-12">
        <h2 class="text-2xl font-bold mb-4 capitalize text-gray-200"><%= status %> (<%= rows.length %>)</h2>
        <div class="overflow-x-auto bg-gray-900 rounded-lg shadow">
            <table class="min-w-full table-auto data-table" data-status="<%= status %>">
                <thead class="bg-gray-800 text-gray-400 text-left">
                    <tr>
                        <th class="px-4 py-2">Ref</th>
                        <th class="px-4 py-2">Tags & Status</th>
                        <th class="px-4 py-2 text-right">OSM Link</th>
                    </tr>
                </thead>
                <tbody class="text-gray-300">
                    <% rows.forEach(function(r) { %>
                        <tr class="border-b border-gray-700 hover:bg-gray-800 align-top">
                            <td class="px-4 py-2 font-medium"><%= r.ref %></td>
                            <td class="px-4 py-2">
                                <div class="space-y-4">
                                    <% r.tags.forEach(function(t) { %>
                                        <div class="bg-gray-800/50 p-3 rounded border border-gray-700">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-sm font-bold uppercase tracking-wider text-gray-400"><%= t.tag %></span>
                                                <span class="text-xs px-2 py-0.5 rounded-full bg-gray-700 text-gray-300 border border-gray-600"><%= t.status %></span>
                                            </div>
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                <div>
                                                    <span class="block text-[10px] uppercase text-gray-500 mb-1">OSM</span>
                                                    <code class="text-sm break-all"><%= t.osmValue %></code>
                                                </div>
                                                <div>
                                                    <span class="block text-[10px] uppercase text-gray-500 mb-1">Spider</span>
                                                    <code class="text-sm break-all"><%= t.spiderValue %></code>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </td>
                            <td class="px-4 py-2 text-right">
                                <% if (r.osmId) { %>
                                    <% const typeMap = { 'n': 'node', 'w': 'way', 'r': 'relation' }; %>
                                    <% const typeChar = r.osmId.toString()[0]; %>
                                    <% const id = r.osmId.toString().substring(1); %>
                                    <% if (typeMap[typeChar]) { %>
                                        <a href="https://www.openstreetmap.org/<%= typeMap[typeChar] %>/<%= id %>" target="_blank" class="inline-flex items-center text-blue-400 hover:underline">
                                            <span><%= r.osmId %></span>
                                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                        </a>
                                    <% } else { %>
                                        <span class="text-gray-600">N/A</span>
                                    <% } %>
                                <% } else { %>
                                    <span class="text-gray-600">N/A</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <div class="mt-4 flex justify-between items-center pagination-controls" data-status="<%= status %>">
            <button class="prev-btn bg-gray-700 px-3 py-1 rounded disabled:opacity-50">Previous</button>
            <span class="page-info">Page 1 of 1</span>
            <button class="next-btn bg-gray-700 px-3 py-1 rounded disabled:opacity-50">Next</button>
        </div>
    </div>
<% }) %>

<script>
    const PAGE_SIZE = 50;
    document.querySelectorAll('.data-table').forEach(table => {
        const status = table.dataset.status;
        const rows = Array.from(table.querySelectorAll('tbody tr'));
        const controls = document.querySelector(`.pagination-controls[data-status="${status}"]`);
        const pageInfo = controls.querySelector('.page-info');
        const prevBtn = controls.querySelector('.prev-btn');
        const nextBtn = controls.querySelector('.next-btn');

        let currentPage = 1;
        const totalPages = Math.ceil(rows.length / PAGE_SIZE);

        function update() {
            rows.forEach((row, i) => {
                row.style.display = (i >= (currentPage-1)*PAGE_SIZE && i < currentPage*PAGE_SIZE) ? '' : 'none';
            });
            pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages || totalPages === 0;
        }

        prevBtn.onclick = () => { if(currentPage > 1) { currentPage--; update(); } };
        nextBtn.onclick = () => { if(currentPage < totalPages) { currentPage++; update(); } };

        update();
    });
</script>
